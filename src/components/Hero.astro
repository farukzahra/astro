---
import { siteConfig } from '../config';
---

<section class="lumen-hero px-6 py-16 md:px-12 md:py-20">
  <div class="max-w-3xl">
    <p class="lumen-section-heading">Java · Spring · AI Engineering</p>
    <h1 class="lumen-page-title mt-4 text-4xl md:text-6xl">Technical knowledge base</h1>
    <p class="mt-5 text-lg leading-relaxed md:text-xl" style="color: var(--lumen-ink-2)">
      {siteConfig.description}
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a href="/articles" class="lumen-btn-primary">Browse articles</a>
      <a href={siteConfig.github} target="_blank" rel="noreferrer" class="lumen-btn-outline">
        GitHub
      </a>
    </div>
  </div>
</section>
