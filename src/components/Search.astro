<section id="search" aria-labelledby="search-heading" class="lumen-island p-6">
  <h2 id="search-heading" class="lumen-section-heading text-base">Search</h2>
  <p class="mt-2 text-sm" style="color: var(--lumen-ink-2)">
    Pagefind — offline search after the production build.
  </p>
  <div class="pagefind-ui mt-4" data-pagefind-ui></div>
</section>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" defer></script>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof window.PagefindUI === 'function') {
      new window.PagefindUI({ element: '[data-pagefind-ui]', showImages: false });
    }
  });
</script>

<script>
  declare global {
    interface Window {
      PagefindUI?: new (options: { element: string; showImages: boolean }) => void;
    }
  }
</script>
