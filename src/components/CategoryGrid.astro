---
import { categories } from '../config';
---

<section aria-labelledby="categories-heading">
  <h2 id="categories-heading" class="lumen-section-heading text-base">Categories</h2>
  <div class="mt-6 flex flex-wrap gap-3">
    {
      categories.map((category) => (
        <a href={`/articles?category=${encodeURIComponent(category)}`} class="lumen-tag hover:opacity-90">
          {category}
        </a>
      ))
    }
  </div>
</section>
