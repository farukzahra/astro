---
import { siteConfig } from '../config';
const year = new Date().getFullYear();
---

<footer class="border-t py-10" style="border-color: var(--color-border)">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-semibold">{siteConfig.title}</p>
      <p class="mt-1 text-sm" style="color: var(--color-muted)">{siteConfig.description}</p>
    </div>
    <div class="flex flex-wrap gap-4 text-sm">
      <a href={siteConfig.github} target="_blank" rel="noreferrer" class="hover:opacity-80">GitHub</a>
      <a href={siteConfig.linkedin} target="_blank" rel="noreferrer" class="hover:opacity-80">LinkedIn</a>
      <a href="/rss.xml" class="hover:opacity-80">RSS</a>
    </div>
  </div>
  <p class="mx-auto mt-8 max-w-6xl px-4 text-xs" style="color: var(--color-muted)">
    © {year} {siteConfig.author}. Gerado com Astro.
  </p>
</footer>
