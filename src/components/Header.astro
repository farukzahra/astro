---
import { siteConfig } from '../config';

const pathname = Astro.url.pathname;

type NavLink = {
  href: string;
  label: string;
  external?: boolean;
  isActive: boolean;
};

const links: NavLink[] = [
  { href: '/', label: 'Home', isActive: pathname === '/' },
  {
    href: '/articles',
    label: 'Articles',
    isActive: pathname === '/articles' || pathname.startsWith('/articles/'),
  },
  { href: '/about', label: 'About', isActive: pathname === '/about' },
  { href: siteConfig.resumeUrl, label: 'Resume', external: true, isActive: false },
  { href: siteConfig.github, label: 'GitHub', external: true, isActive: false },
];
---

<nav class="app-top-nav" aria-label="Site navigation">
  {
    links.map((link) =>
      link.external ? (
        <a href={link.href} target="_blank" rel="noreferrer">
          {link.label}
        </a>
      ) : (
        <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>
          {link.label}
        </a>
      ),
    )
  }
</nav>
