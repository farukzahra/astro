---
import { siteConfig } from '../config';
import ThemeToggle from './ThemeToggle.astro';
---

<header
  class="sticky top-0 z-50 border-b backdrop-blur-md"
  style="border-color: var(--color-border); background: color-mix(in srgb, var(--color-surface) 85%, transparent)"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="text-lg font-bold tracking-tight">
      {siteConfig.author}
      <span class="font-normal" style="color: var(--color-muted)"> / blog</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm md:flex" aria-label="Main">
      <a href="/articles" class="hover:opacity-80">Articles</a>
      <a href="/about" class="hover:opacity-80">About</a>
      <a href={siteConfig.github} target="_blank" rel="noreferrer" class="hover:opacity-80">GitHub</a>
    </nav>
    <div class="flex items-center gap-2">
      <ThemeToggle />
    </div>
  </div>
</header>
