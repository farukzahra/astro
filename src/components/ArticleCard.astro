---
import type { CollectionEntry } from 'astro:content';
import { isDevPreview } from '../lib/articles';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, publishDate, tags, draft } = article.data;
const showDraftBadge = draft && isDevPreview();
const href = `/articles/${article.id}`;
---

<article class="lumen-panel group p-6">
  <div class="flex flex-wrap items-center gap-2">
    <time class="lumen-section-heading" datetime={publishDate.toISOString()}>
      {publishDate.toLocaleDateString('en-US', { dateStyle: 'medium' })}
    </time>
    {
      showDraftBadge && (
        <span
          class="rounded px-2 py-0.5 text-xs font-semibold uppercase tracking-wide"
          style="background: color-mix(in srgb, var(--lumen-accent) 18%, transparent); color: var(--lumen-accent)"
        >
          Draft
        </span>
      )
    }
  </div>
  <h3 class="mt-3 text-xl font-normal leading-snug" style="font-family: var(--lumen-font-display); color: var(--lumen-ink)">
    <a href={href} class="no-underline hover:underline">{title}</a>
  </h3>
  <p class="mt-2 text-sm leading-relaxed" style="color: var(--lumen-ink-2)">{description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {tags.slice(0, 3).map((tag) => (
      <span class="lumen-tag">{tag}</span>
    ))}
  </div>
</article>
