---
import { siteConfig } from '../config';

interface Props {
  exampleSlug: string;
}

const { exampleSlug } = Astro.props;

const exampleUrl = `${siteConfig.githubRepo}/tree/${siteConfig.githubBranch}/examples/${exampleSlug}`;
---

<aside
  class="mb-8 flex flex-wrap items-center gap-3 rounded-xl border px-4 py-3 text-sm"
  style="border-color: var(--color-border); background: var(--color-surface-elevated)"
>
  <span aria-hidden="true">💻</span>
  <span style="color: var(--color-muted)">Full runnable code for this article:</span>
  <a
    href={exampleUrl}
    target="_blank"
    rel="noreferrer"
    class="font-medium"
    style="color: var(--color-accent)"
  >
    GitHub → examples/{exampleSlug}
  </a>
</aside>
