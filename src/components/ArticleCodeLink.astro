---
import { siteConfig } from '../config';

interface Props {
  exampleSlug: string;
}

const { exampleSlug } = Astro.props;

const exampleUrl = `${siteConfig.githubRepo}/tree/${siteConfig.githubBranch}/examples/${exampleSlug}`;
---

<aside class="lumen-island mb-8 flex flex-wrap items-center gap-3 px-4 py-3 text-sm">
  <span aria-hidden="true">💻</span>
  <span style="color: var(--lumen-ink-2)">Full runnable code for this article:</span>
  <a
    href={exampleUrl}
    target="_blank"
    rel="noreferrer"
    class="lumen-section-heading text-xs no-underline hover:underline"
    style="color: var(--lumen-accent)"
  >
    GitHub → examples/{exampleSlug}
  </a>
</aside>
