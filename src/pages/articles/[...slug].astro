---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { filterVisibleArticles } from '../../lib/articles';
import { findAlternateArticle } from '../../lib/i18n';

export async function getStaticPaths() {
  const articles = filterVisibleArticles(await getCollection('articles'));
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const allArticles = filterVisibleArticles(await getCollection('articles'));
const alternateArticle = findAlternateArticle(allArticles, article);
const { Content } = await render(article);
---

<ArticleLayout article={article} alternateArticle={alternateArticle}>
  <Content />
</ArticleLayout>
