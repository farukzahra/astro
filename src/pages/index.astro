---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import Search from '../components/Search.astro';
import { siteConfig } from '../config';
import { filterArticlesForListing } from '../lib/i18n';

const articles = filterArticlesForListing(
  (await getCollection('articles')).filter((article) => !article.data.draft),
)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const latest = articles.slice(0, 6);
const featured = articles.filter((article) => article.data.featured).slice(0, 3);
const series = [...new Set(articles.map((article) => article.data.series).filter(Boolean))];
---

<BaseLayout>
  <div class="mx-auto max-w-6xl space-y-16 px-4 py-10 md:py-14">
    <Hero />

    <Search />

    {
      featured.length > 0 && (
        <section aria-labelledby="featured-heading">
          <h2 id="featured-heading" class="lumen-section-heading text-base">
            Featured
          </h2>
          <div class="mt-6 grid gap-6 md:grid-cols-3">
            {featured.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </section>
      )
    }

    <section aria-labelledby="latest-heading">
      <div class="flex items-end justify-between gap-4">
        <h2 id="latest-heading" class="lumen-section-heading text-base">
          Latest articles
        </h2>
        <a href="/articles" class="lumen-section-heading text-xs no-underline hover:underline">
          View all
        </a>
      </div>
      <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {latest.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </section>

    <CategoryGrid />

    {
      series.length > 0 && (
        <section aria-labelledby="series-heading">
          <h2 id="series-heading" class="lumen-section-heading text-base">
            Recent series
          </h2>
          <ul class="mt-6 grid gap-3 md:grid-cols-2">
            {series.map((name) => (
              <li
                class="rounded-lg border px-4 py-3 text-sm font-medium"
                style="border-color: var(--lumen-rule); background: var(--lumen-panel); color: var(--lumen-ink)"
              >
                {name}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="newsletter" aria-labelledby="newsletter-heading" class="lumen-island p-8">
      <h2 id="newsletter-heading" class="lumen-section-heading text-base">Newsletter</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed" style="color: var(--lumen-ink-2)">
        Coming soon: subscribe to get new articles on Java, Spring Boot, and AI Engineering.
      </p>
    </section>

    <section class="flex flex-wrap gap-4 text-sm">
      <a href={siteConfig.github} target="_blank" rel="noreferrer" class="lumen-section-heading text-xs no-underline hover:underline">
        GitHub →
      </a>
      <a href={siteConfig.linkedin} target="_blank" rel="noreferrer" class="lumen-section-heading text-xs no-underline hover:underline">
        LinkedIn →
      </a>
    </section>
  </div>
</BaseLayout>
