---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
---

<BaseLayout title="Sobre" description="Sobre o blog técnico de Faruk.">
  <div class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">Sobre</h1>
    <div class="prose mt-8">
      <p>
        Este blog documenta aprendizado e experiência prática em desenvolvimento backend, arquitetura de
        software e engenharia de IA.
      </p>
      <p>
        O foco inclui <strong>Java</strong>, <strong>Spring Boot</strong>, <strong>MCP</strong>,
        <strong>LLMs</strong>, <strong>RAG</strong>, system design e notas de carreira/estudo.
      </p>
      <p>
        O site é gerado estaticamente com <a href="https://astro.build">Astro</a>, publicado na VPS em
        <a href={siteConfig.url}>{siteConfig.url}</a>.
      </p>
    </div>
  </div>
</BaseLayout>
