---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config';
---

<BaseLayout title="About" description="About Faruk's technical blog.">
  <div class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">About</h1>
    <div class="prose mt-8">
      <p>
        This blog documents hands-on learning and practical experience in backend development, software
        architecture, and AI engineering.
      </p>
      <p>
        Topics include <strong>Java</strong>, <strong>Spring Boot</strong>, <strong>MCP</strong>,
        <strong>LLMs</strong>, <strong>RAG</strong>, system design, and career/study notes.
      </p>
      <p>
        The site is statically generated with <a href="https://astro.build">Astro</a> and published on a VPS at
        <a href={siteConfig.url}>{siteConfig.url}</a>.
      </p>
    </div>
  </div>
</BaseLayout>
