---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'en' | 'pt-BR';
  alternateLinks?: Array<{ lang: 'en' | 'pt-BR'; href: string }>;
}

import { siteConfig } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import '../styles/global.css';

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = '/favicon.svg',
  lang = siteConfig.locale,
  alternateLinks,
} = Astro.props;

const htmlLang = lang === 'pt-BR' ? 'pt-BR' : lang;
const canonical = new URL(Astro.url.pathname, siteConfig.url).href;
const pageTitle = title === siteConfig.title ? title : `${title} · ${siteConfig.title}`;
const hreflangMap = { en: 'en', 'pt-BR': 'pt-BR' } as const;
---

<!doctype html>
<html lang={htmlLang} class="lumen-theme-active">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <link rel="canonical" href={canonical} />
    {
      alternateLinks?.map(({ lang: alternateLang, href }) => (
        <link
          rel="alternate"
          hreflang={hreflangMap[alternateLang]}
          href={new URL(href, siteConfig.url).href}
        />
      ))
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, siteConfig.url).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/geist@1.3.1/dist/fonts/geist-sans/style.css"
    />
    <GoogleAnalytics />
  </head>
  <body class="lumen-theme-active min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
