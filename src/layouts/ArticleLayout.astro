---
import BaseLayout from './BaseLayout.astro';
import MermaidInit from '../components/MermaidInit.astro';
import GiscusComments from '../components/GiscusComments.astro';
import ArticleCodeLink from '../components/ArticleCodeLink.astro';
import FontSizeToggle from '../components/FontSizeToggle.astro';
import LanguageToggle from '../components/LanguageToggle.astro';
import type { CollectionEntry } from 'astro:content';
import { isDevPreview } from '../lib/articles';
import { articleDateLocales, articleUrl, giscusLangs } from '../lib/i18n';

interface Props {
  article: CollectionEntry<'articles'>;
  alternateArticle?: CollectionEntry<'articles'>;
}

const { article, alternateArticle } = Astro.props;
const { title, description, publishDate, updatedDate, author, tags, exampleSlug, lang, draft } =
  article.data;
const showDraftBanner = draft && isDevPreview();
const dateLocale = articleDateLocales[lang];
const alternateHref = alternateArticle ? articleUrl(alternateArticle.id) : undefined;
const alternateLinks = alternateArticle
  ? [
      { lang: article.data.lang, href: articleUrl(article.id) },
      { lang: alternateArticle.data.lang, href: articleUrl(alternateArticle.id) },
    ]
  : undefined;
const updatedLabel = lang === 'pt-BR' ? 'atualizado' : 'updated';
---

<BaseLayout title={title} description={description} lang={lang} alternateLinks={alternateLinks}>
  <div class="article-readable mx-auto max-w-5xl px-4 py-12 md:py-16" data-article-readable>
    <script is:inline>
      (function () {
        const container = document.currentScript?.parentElement;
        const scale = localStorage.getItem('font-scale');
        if (container && scale && !Number.isNaN(parseFloat(scale))) {
          container.style.setProperty('--font-scale', scale);
        }
      })();
    </script>

    <div class="mb-6 flex items-center justify-end gap-2">
      <LanguageToggle
        currentLang={lang}
        alternateHref={alternateHref}
        alternateLang={alternateArticle?.data.lang}
      />
      <FontSizeToggle />
    </div>

    {
      showDraftBanner && (
        <div
          class="mb-6 rounded-lg border px-4 py-3 text-sm font-medium"
          style="border-color: var(--lumen-accent); background: color-mix(in srgb, var(--lumen-accent) 12%, transparent); color: var(--lumen-ink)"
          role="status"
        >
          {lang === 'pt-BR'
            ? 'Rascunho — visível só em localhost. Defina draft: false para publicar.'
            : 'Draft — visible on localhost only. Set draft: false to publish.'}
        </div>
      )
    }

    <article>
      <header class="article-header mb-10 border-b pb-8" style="border-color: var(--lumen-rule)">
        <p class="article-meta" style="color: var(--lumen-accent)">
          {publishDate.toLocaleDateString(dateLocale, { dateStyle: 'long' })}
          {updatedDate && updatedDate > publishDate && (
            <span> · {updatedLabel} {updatedDate.toLocaleDateString(dateLocale, { dateStyle: 'long' })}</span>
          )}
        </p>
        <h1 class="article-title mt-3 tracking-tight">{title}</h1>
        <p class="article-description mt-4" style="color: var(--lumen-ink-2)">{description}</p>
        <div class="article-byline mt-6 flex flex-wrap items-center gap-3" style="color: var(--lumen-ink-2)">
          <span>{lang === 'pt-BR' ? 'Por' : 'By'} {author}</span>
          {tags.map((tag) => (
            <span class="lumen-tag">{tag}</span>
          ))}
        </div>
      </header>
      {exampleSlug && <ArticleCodeLink exampleSlug={exampleSlug} />}
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
  <GiscusComments lang={giscusLangs[lang]} uiLang={lang} />
  <MermaidInit />
</BaseLayout>
