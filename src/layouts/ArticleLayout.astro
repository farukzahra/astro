---
import BaseLayout from './BaseLayout.astro';
import MermaidInit from '../components/MermaidInit.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, publishDate, updatedDate, author, tags } = article.data;
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <header class="mb-10 border-b pb-8" style="border-color: var(--color-border)">
      <p class="text-sm uppercase tracking-wide" style="color: var(--color-muted)">
        {publishDate.toLocaleDateString('pt-BR', { dateStyle: 'long' })}
        {updatedDate && updatedDate > publishDate && (
          <span> · atualizado {updatedDate.toLocaleDateString('pt-BR', { dateStyle: 'long' })}</span>
        )}
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">{title}</h1>
      <p class="mt-4 text-lg" style="color: var(--color-muted)">{description}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3 text-sm" style="color: var(--color-muted)">
        <span>Por {author}</span>
        {tags.map((tag) => (
          <span
            class="rounded-full px-3 py-1 text-xs font-medium"
            style="background: var(--color-accent-soft); color: var(--color-accent)"
          >
            {tag}
          </span>
        ))}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <MermaidInit />
</BaseLayout>
