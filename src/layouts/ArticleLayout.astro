---
import BaseLayout from './BaseLayout.astro';
import MermaidInit from '../components/MermaidInit.astro';
import GiscusComments from '../components/GiscusComments.astro';
import ArticleCodeLink from '../components/ArticleCodeLink.astro';
import FontSizeToggle from '../components/FontSizeToggle.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, publishDate, updatedDate, author, tags, exampleSlug } = article.data;
---

<BaseLayout title={title} description={description}>
  <div class="article-readable mx-auto max-w-5xl px-4 py-12 md:py-16" data-article-readable>
    <script is:inline>
      (function () {
        const container = document.currentScript?.parentElement;
        const scale = localStorage.getItem('font-scale');
        if (container && scale && !Number.isNaN(parseFloat(scale))) {
          container.style.setProperty('--font-scale', scale);
        }
      })();
    </script>

    <div class="mb-6 flex justify-end">
      <FontSizeToggle />
    </div>

    <article>
      <header class="article-header mb-10 border-b pb-8" style="border-color: var(--lumen-rule)">
        <p class="article-meta" style="color: var(--lumen-accent)">
          {publishDate.toLocaleDateString('en-US', { dateStyle: 'long' })}
          {updatedDate && updatedDate > publishDate && (
            <span> · updated {updatedDate.toLocaleDateString('en-US', { dateStyle: 'long' })}</span>
          )}
        </p>
        <h1 class="article-title mt-3 tracking-tight">{title}</h1>
        <p class="article-description mt-4" style="color: var(--lumen-ink-2)">{description}</p>
        <div class="article-byline mt-6 flex flex-wrap items-center gap-3" style="color: var(--lumen-ink-2)">
          <span>By {author}</span>
          {tags.map((tag) => (
            <span class="lumen-tag">{tag}</span>
          ))}
        </div>
      </header>
      {exampleSlug && <ArticleCodeLink exampleSlug={exampleSlug} />}
      <div class="prose">
        <slot />
      </div>
    </article>
  </div>
  <GiscusComments />
  <MermaidInit />
</BaseLayout>
